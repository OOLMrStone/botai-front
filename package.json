{
  "name": "botai-front",
  "version": "0.1.0",
  "private": true,
  "browserslist": [
    "chrome 111",
    "edge 111",
    "firefox 111",
    "safari 16.4"
  ],
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "scripts": {
    "dev": "NEXT_PUBLIC_APP_ENV=local NEXT_PUBLIC_API_MOCK=1 next dev",
    "dev:api": "NEXT_PUBLIC_APP_ENV=local NEXT_PUBLIC_API_MOCK=0 next dev",
    "build": "NEXT_PUBLIC_APP_ENV=prod NEXT_PUBLIC_API_MOCK=0 next build",
    "build:dev": "NEXT_PUBLIC_APP_ENV=dev NEXT_PUBLIC_API_MOCK=1 next build",
    "start": "NEXT_PUBLIC_APP_ENV=prod NEXT_PUBLIC_API_MOCK=0 next start",
    "start:dev": "NEXT_PUBLIC_APP_ENV=dev NEXT_PUBLIC_API_MOCK=1 next start",
    "lint": "eslint . && npm run test:design",
    "test:drawing": "node --test scripts/test-task-drawing.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "test:design": "node --test scripts/test-design-system.mjs scripts/test-work-3-behavior.mjs scripts/test-typography.mjs scripts/test-brand.mjs scripts/test-attempt-persistence.mjs scripts/test-onboarding-completion.mjs scripts/test-content-import.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "katex": "0.16.22",
    "lucide-react": "^1.23.0",
    "next": "16.3.8",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.14"
  },
  "overrides": {
    "keyv": "4.5.4",
    "flat-cache": "4.0.1",
    "file-entry-cache": "8.0.0",
    "baseline-browser-mapping": "2.11.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "shadcn": "^4.13.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
